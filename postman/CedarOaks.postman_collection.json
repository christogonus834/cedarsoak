            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Member paid twice by mistake\",\n  \"memberConsentNote\": \"Member called support and confirmed via phone\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/cooperatives/{{cooperativeId}}/payments/{{lastLedgerEntryId}}/reverse",
              "host": [
