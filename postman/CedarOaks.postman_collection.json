                "payments",
                "{{lastLedgerEntryId}}",
                "reverse"
              ]
            },
            "description": "Uses the ledgerEntryId captured by 'Recent Payments' above \u2014 run that request first. This can only succeed ONCE per payment; running it twice on the same entry correctly returns a Conflict error."
          }
