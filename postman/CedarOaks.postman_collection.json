{
  "info": {
    "_postman_id": "cedaroaks-api-collection",
    "name": "CedarOaks API",
    "description": "CedarOaks Cooperative Platform API. Import this alongside the CedarOaks - Local environment. Requests are ordered to be run top-to-bottom on a fresh database \u2014 each one automatically saves the values the next request needs (accessToken, membershipId, etc.) via test scripts, so you rarely need to copy/paste anything by hand.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mary{{$randomInt}}@example.com\",\n  \"phoneNumber\": \"+234812334{{$randomInt}}\",\n  \"firstName\": \"Mary\",\n  \"lastName\": \"Ikott\",\n  \"password\": \"Testpass1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201/200', function () { pm.expect([200,201]).to.include(pm.response.code); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('accessToken', data.accessToken);",
                  "pm.environment.set('refreshToken', data.refreshToken);",
                  "pm.environment.set('userId', data.user.id);",
                  "pm.test('Response does not leak passwordHash', function () { pm.expect(data.user.passwordHash).to.be.undefined; });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "{{$randomUUID}}",
                "description": "A stable per-device id in real use; randomized here per Postman run for convenience. Set this to a fixed value manually if you want to test the 'trusted device' behavior across repeated requests."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mary@example.com\",\n  \"password\": \"Testpass1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "May return tokens directly, or { challengeRequired: true, challengeId } if this login looks unusual for the account (very likely on a fresh test account's first login, or for any admin/staff account, since they are challenged on just one signal). If challenged, run 'Confirm Login Challenge' next with the code from your server console."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.challengeRequired) {",
                  "  pm.environment.set('challengeId', data.challengeId);",
                  "  console.log('Login blocked pending confirmation. Reasons: ' + JSON.stringify(data.reasons) + '. Check server console (NOTIFICATIONS_DRY_RUN=true) for the code, then run \\'Confirm Login Challenge\\'.');",
                  "} else {",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "  pm.environment.set('refreshToken', data.refreshToken);",
                  "  pm.environment.set('userId', data.user.id);",
                  "}",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Confirm Login Challenge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-device-id",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login",
                "confirm"
              ]
            },
            "description": "Only needed when Login returned challengeRequired: true. Get the real code from your server console (search for '[DRY RUN] Email') and paste it in place of 123456 before sending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('accessToken', data.accessToken);",
                  "pm.environment.set('refreshToken', data.refreshToken);",
                  "pm.environment.set('userId', data.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('accessToken', data.accessToken);",
                  "pm.environment.set('refreshToken', data.refreshToken);",
                  "pm.test('Old refresh token was rotated (new token differs)', function () { pm.expect(data.refreshToken).to.not.be.empty; });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
